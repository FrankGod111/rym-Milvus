# Relational metadata/chunk store. SQLite is the local default.
KNOWLEDGE_DATABASE_URL=sqlite:///./data/erp/knowledge.db

# The clone defaults to Milvus. Use KNOWLEDGE_VECTOR_BACKEND=dify only for
# compatibility with the original Dify-managed vector path.
KNOWLEDGE_VECTOR_BACKEND=milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge_chunks

# hash is deterministic and dependency-free for smoke tests. Production should
# use ollama (or replace the provider with the organisation's embedding API).
KNOWLEDGE_EMBEDDING_PROVIDER=hash
KNOWLEDGE_VECTOR_DIMENSION=256
KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
